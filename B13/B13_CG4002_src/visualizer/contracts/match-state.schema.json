{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cg4002-b13.local/schemas/match-state.schema.json",
  "title": "MatchState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "seq",
    "timestamp",
    "player_1",
    "player_2",
    "round_time",
    "state"
  ],
  "$defs": {
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health", "stamina"],
      "properties": {
        "health": { "type": "number", "minimum": 0, "maximum": 100 },
        "stamina": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "active_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "item_type",
        "owner_player",
        "distance_m",
        "bearing_degrees",
        "magnitude",
        "remaining_ms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "item_type": {
          "type": "string",
          "enum": ["HEALTH", "ATTACK_BOOST"]
        },
        "owner_player": { "type": "integer", "enum": [1, 2] },
        "distance_m": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "bearing_degrees": { "type": "number", "minimum": -90, "maximum": 90 },
        "magnitude": { "type": "number", "minimum": 0, "maximum": 100 },
        "remaining_ms": { "type": "integer", "minimum": 0, "maximum": 120000 }
      }
    }
  },
  "properties": {
    "type": { "const": "MatchState" },
    "seq": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "integer", "minimum": 0 },
    "player_1": { "$ref": "#/$defs/player" },
    "player_2": { "$ref": "#/$defs/player" },
    "round_time": { "type": "number", "minimum": 0 },
    "active_items": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/active_item" }
    },
    "state": {
      "type": "string",
      "enum": [
        "LOBBY",
        "CALIBRATING",
        "COUNTDOWN",
        "FIGHTING",
        "PAUSED",
        "ROUND_END",
        "MATCH_END"
      ]
    }
  }
}
