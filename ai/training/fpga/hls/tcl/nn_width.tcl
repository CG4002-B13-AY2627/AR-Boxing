# The selected width, for the Tcl half of the flow.
#
# selected_width.hpp is generated by export/emit.py from the checkpoint in
# qmodel/, and params.hpp reads the same number to default NN_WIDTH. Both
# halves therefore inherit the export's choice instead of restating it, and a
# width given on the command line still wins.

namespace eval nn_width {}

proc nn_width::selected {hls_dir} {
    set path [file join $hls_dir "selected_width.hpp"]

    if {![file exists $path]} {
        error "no $path: run the export before building, or pass a width."
    }

    set channel [open $path r]
    set text [read $channel]
    close $channel

    if {![regexp {#define\s+NN_WIDTH_SELECTED\s+([0-9]+)} $text -> width]} {
        error "$path does not define NN_WIDTH_SELECTED; regenerate it."
    }

    return $width
}
