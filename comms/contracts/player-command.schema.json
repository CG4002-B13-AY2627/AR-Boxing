{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cg4002-b13.local/schemas/v2/player-command.schema.json",
  "title": "PlayerCommand v2",
  "description": "Phone -> Ultra96 request. Never a state change: the phone waits for a MatchState that reflects it. Send only when ServerWelcome.supports_player_commands is true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "match_id",
    "stream_id",
    "player_id",
    "command_id",
    "command",
    "timestamp"
  ],
  "properties": {
    "type": { "const": "PlayerCommand" },
    "protocol_version": { "const": 2 },
    "match_id": { "$ref": "#/$defs/identifier" },
    "stream_id": { "$ref": "#/$defs/identifier" },
    "player_id": { "type": "integer", "enum": [1, 2] },
    "command_id": {
      "description": "Unique per player and stream. A repeated command_id is a retry and must be ignored.",
      "$ref": "#/$defs/identifier"
    },
    "command": {
      "type": "string",
      "enum": ["READY", "UNREADY", "CALIBRATED", "PAUSE", "RESUME"]
    },
    "timestamp": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
