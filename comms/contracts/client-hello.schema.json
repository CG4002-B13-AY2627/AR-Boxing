{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cg4002-b13.local/schemas/v2/client-hello.schema.json",
  "title": "ClientHello v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "protocol_version", "client_id", "player_id"],
  "properties": {
    "type": { "const": "ClientHello" },
    "protocol_version": { "const": 2 },
    "client_id": { "$ref": "#/$defs/identifier" },
    "player_id": { "type": "integer", "enum": [1, 2] }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
