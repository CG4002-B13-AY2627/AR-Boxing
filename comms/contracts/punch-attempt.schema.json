{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cg4002-b13.local/schemas/v2/punch-attempt.schema.json",
  "title": "PunchAttempt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "match_id",
    "stream_id",
    "attack_id",
    "timestamp",
    "source_player",
    "target_player",
    "punch",
    "confidence",
    "intensity",
    "response_timeout_ms"
  ],
  "properties": {
    "type": { "const": "PunchAttempt" },
    "protocol_version": { "const": 2 },
    "match_id": { "$ref": "#/$defs/identifier" },
    "stream_id": { "$ref": "#/$defs/identifier" },
    "attack_id": { "$ref": "#/$defs/identifier" },
    "timestamp": { "type": "integer", "minimum": 0 },
    "source_player": { "type": "integer", "enum": [1, 2] },
    "target_player": { "type": "integer", "enum": [1, 2] },
    "punch": {
      "type": "string",
      "enum": [
        "JAB",
        "CROSS",
        "LEFT_HOOK",
        "RIGHT_HOOK",
        "LEFT_UPPERCUT",
        "RIGHT_UPPERCUT"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "response_timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 2000
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
