{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cg4002-b13.local/schemas/v2/match-state.schema.json",
  "title": "MatchState v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "match_id",
    "stream_id",
    "seq",
    "timestamp",
    "player_1",
    "player_2",
    "round_time",
    "state",
    "active_items"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health",
        "stamina",
        "is_blocking",
        "attack_multiplier",
        "attack_multiplier_remaining_ms"
      ],
      "properties": {
        "health": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "stamina": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "is_blocking": {
          "type": "boolean"
        },
        "attack_multiplier": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "attack_multiplier_remaining_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "connected": {
          "description": "Optional. The server holds a live socket for this player.",
          "type": "boolean"
        },
        "ready": {
          "description": "Optional. Pressed Ready (LOBBY), I'm set (CALIBRATING) or Resume (PAUSED). Cleared on every phase change.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "attack_multiplier": {
                "const": 1
              }
            },
            "required": [
              "attack_multiplier"
            ]
          },
          "then": {
            "properties": {
              "attack_multiplier_remaining_ms": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "attack_multiplier_remaining_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120000
              }
            }
          }
        }
      ]
    },
    "active_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "item_type",
        "owner_player",
        "distance_m",
        "bearing_degrees",
        "magnitude",
        "effect_duration_ms",
        "remaining_ms"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "item_type": {
          "type": "string",
          "enum": [
            "HEALTH",
            "STAMINA",
            "ATTACK_MULTIPLIER"
          ]
        },
        "owner_player": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "distance_m": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.0
        },
        "bearing_degrees": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "magnitude": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "effect_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "remaining_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "item_type": {
                "enum": [
                  "HEALTH",
                  "STAMINA"
                ]
              }
            },
            "required": [
              "item_type"
            ]
          },
          "then": {
            "properties": {
              "magnitude": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "effect_duration_ms": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "item_type": {
                "const": "ATTACK_MULTIPLIER"
              }
            },
            "required": [
              "item_type"
            ]
          },
          "then": {
            "properties": {
              "magnitude": {
                "type": "number",
                "exclusiveMinimum": 1,
                "maximum": 3
              },
              "effect_duration_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120000
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "type": {
      "const": "MatchState"
    },
    "protocol_version": {
      "const": 2
    },
    "match_id": {
      "$ref": "#/$defs/identifier"
    },
    "stream_id": {
      "$ref": "#/$defs/identifier"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "player_1": {
      "$ref": "#/$defs/player"
    },
    "player_2": {
      "$ref": "#/$defs/player"
    },
    "round_time": {
      "type": "number",
      "minimum": 0
    },
    "active_items": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/active_item"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "LOBBY",
        "CALIBRATING",
        "COUNTDOWN",
        "FIGHTING",
        "PAUSED",
        "ROUND_END",
        "MATCH_END"
      ]
    },
    "phase_remaining_ms": {
      "description": "Optional. Time left in a timed phase (COUNTDOWN, ROUND_END); 0 when the phase has no timer.",
      "type": "integer",
      "minimum": 0,
      "maximum": 600000
    },
    "match_result": {
      "description": "Authoritative result. Optional; absent means PENDING. Only MATCH_END may carry a decided result.",
      "type": "string",
      "enum": [
        "PENDING",
        "P1_WIN",
        "P2_WIN",
        "DRAW"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "not": {
              "const": "MATCH_END"
            }
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "match_result": {
            "const": "PENDING"
          }
        }
      }
    }
  ],
  "description": "Complete authority state. Sent every 100 ms and after mutations. HEALTH packs spawn for each player every 30 FIGHTING seconds, first at 30; expiry is processed before spawning. Item lifetime and spawn schedule freeze outside FIGHTING."
}
