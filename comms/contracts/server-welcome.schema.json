{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cg4002-b13.local/schemas/v2/server-welcome.schema.json",
  "title": "ServerWelcome v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "match_id",
    "stream_id",
    "player_id",
    "server_timestamp",
    "heartbeat_interval_ms"
  ],
  "properties": {
    "type": { "const": "ServerWelcome" },
    "protocol_version": { "const": 2 },
    "match_id": { "$ref": "#/$defs/identifier" },
    "stream_id": { "$ref": "#/$defs/identifier" },
    "player_id": { "type": "integer", "enum": [1, 2] },
    "server_timestamp": { "type": "integer", "minimum": 0 },
    "heartbeat_interval_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 60000
    },
    "supports_player_commands": {
      "description": "Optional. True when the server accepts PlayerCommand. Absent means false: the phone must not send PlayerCommand.",
      "type": "boolean"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
