{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cg4002-b13.local/schemas/v2/pickup-check.schema.json",
  "title": "PickupCheck v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "match_id",
    "stream_id",
    "request_id",
    "item_id",
    "player_id",
    "response_timeout_ms"
  ],
  "properties": {
    "type": {
      "const": "PickupCheck"
    },
    "protocol_version": {
      "const": 2
    },
    "match_id": {
      "$ref": "#/$defs/identifier"
    },
    "stream_id": {
      "$ref": "#/$defs/identifier"
    },
    "request_id": {
      "$ref": "#/$defs/identifier"
    },
    "item_id": {
      "$ref": "#/$defs/identifier"
    },
    "player_id": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "response_timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 2000
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
