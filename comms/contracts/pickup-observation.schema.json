{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cg4002-b13.local/schemas/v2/pickup-observation.schema.json",
  "title": "PickupObservation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "match_id",
    "stream_id",
    "request_id",
    "item_id",
    "player_id",
    "observation",
    "client_timestamp"
  ],
  "properties": {
    "type": {
      "const": "PickupObservation"
    },
    "protocol_version": {
      "const": 2
    },
    "match_id": {
      "$ref": "#/$defs/identifier"
    },
    "stream_id": {
      "$ref": "#/$defs/identifier"
    },
    "request_id": {
      "$ref": "#/$defs/identifier"
    },
    "item_id": {
      "$ref": "#/$defs/identifier"
    },
    "player_id": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "observation": {
      "enum": [
        "AVAILABLE",
        "ITEM_UNAVAILABLE",
        "TRACKING_UNAVAILABLE"
      ]
    },
    "client_timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "observed_distance_m": {
      "type": "number",
      "minimum": 0
    },
    "hand": {
      "enum": [
        "LEFT",
        "RIGHT"
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observation": {
            "const": "AVAILABLE"
          }
        },
        "required": [
          "observation"
        ]
      },
      "then": {
        "required": [
          "observed_distance_m",
          "hand"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "observed_distance_m"
              ]
            },
            {
              "required": [
                "hand"
              ]
            }
          ]
        }
      }
    }
  ]
}
