{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cg4002-b13.local/schemas/v2/pickup-result.schema.json",
  "title": "PickupResult v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "match_id",
    "stream_id",
    "request_id",
    "item_id",
    "player_id",
    "accepted",
    "reason",
    "server_timestamp"
  ],
  "properties": {
    "type": { "const": "PickupResult" },
    "protocol_version": { "const": 2 },
    "match_id": { "$ref": "#/$defs/identifier" },
    "stream_id": { "$ref": "#/$defs/identifier" },
    "request_id": { "$ref": "#/$defs/identifier" },
    "item_id": { "$ref": "#/$defs/identifier" },
    "player_id": { "type": "integer", "enum": [1, 2] },
    "accepted": { "type": "boolean" },
    "reason": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "ITEM_NOT_FOUND",
        "NOT_OWNER",
        "OUT_OF_RANGE",
        "EXPIRED",
        "DUPLICATE",
        "MATCH_NOT_ACTIVE",
        "INVALID_REQUEST",
        "ITEM_UNAVAILABLE",
        "TRACKING_UNAVAILABLE",
        "OBSERVATION_TIMEOUT"
      ]
    },
    "server_timestamp": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "accepted": { "const": true } },
        "required": ["accepted"]
      },
      "then": { "properties": { "reason": { "const": "ACCEPTED" } } },
      "else": { "properties": { "reason": { "not": { "const": "ACCEPTED" } } } }
    }
  ]
}
